{
  "name": "autopilot-keypad",
  "version": "0.3.1",
  "description": "Autopilot keypad for Signal K: a webapp and a chart plotter extension (Freeboard-SK 3.5 and later) that steer any Autopilot API pilot with keys laid out like a pilot keypad",
  "main": "index.js",
  "files": [
    "index.js",
    "public/",
    "docs/screenshots/",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "prepack": "node scripts/build.mjs"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-plotter-extensions",
    "signalk-category-chart-plotters",
    "autopilot",
    "freeboard-sk"
  ],
  "author": "Colug0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Colug0/autopilot-keypad.git"
  },
  "homepage": "https://github.com/Colug0/autopilot-keypad#readme",
  "bugs": {
    "url": "https://github.com/Colug0/autopilot-keypad/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "signalk": {
    "displayName": "Autopilot keypad",
    "appIcon": "./icon-72x72.png",
    "screenshots": [
      "./docs/screenshots/webapp-wind.jpg",
      "./docs/screenshots/freeboard-window.png",
      "./docs/screenshots/webapp-waypoints.jpg"
    ]
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "signalk-plotterext-bus": "^0.27.0"
  }
}
